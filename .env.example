# ==============================================================================
# PROJECT JARVIS - Environment Configuration
# ==============================================================================

# Application Network Binding
# 0.0.0.0 allows LAN access (e.g. MacBook connecting to Windows host over local Wi-Fi)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Security & Authentication
# Mandatory in production (minimum 32 characters). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_KEY=replace_with_a_secure_random_key_minimum_32_chars_long

# Explicit Allowed CORS Origins (comma-separated; no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Interactive Documentation (/docs, /redoc): Disabled outside development unless set to true
ENABLE_DOCS=false

# WebSocket Single-Use Ticket Expiration (seconds)
WS_TICKET_TTL_SECONDS=30

# Local Ollama Inference (STRICTLY localhost 127.0.0.1, never exposed to LAN or internet)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60.0

# Context Window: Maximum number of recent messages sent to the model as prompt context.
# Note: Full conversation history is ALWAYS stored permanently in SQLite and never deleted.
MAX_HISTORY_MESSAGES=10

# --- Paths Configuration ---
# Windows 11 Production Paths (Default):
JARVIS_DB_PATH=D:\Jarvis\database\jarvis.db
JARVIS_LOG_PATH=D:\Jarvis\logs\jarvis.log

# macOS / Linux Development Paths (Auto-fallback is active if D:\ is unavailable,
# or uncomment the lines below to set explicitly):
# JARVIS_DB_PATH=./data/database/jarvis.db
# JARVIS_LOG_PATH=./data/logs/jarvis.log

